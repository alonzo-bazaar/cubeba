#!/usr/bin/env perl
use strict;
use warnings;
use feature 'signatures';

# setup shit
my $SCRIPT_DIR = path_dir($0);
chdir $SCRIPT_DIR
    or die "could not chdir into project directory [$SCRIPT_DIR]: $!";

# path_dir and path_file will be implemented using these
# File::Spec is a bit less janky than the default basename and dirname functions
use File::Spec::Functions ('splitpath', 'rel2abs');

# https://perldoc.perl.org/IPC::Open3
# we use the open3 function to spawn a subprocess and immediately grab handles to
# its stdin, stdout, and stderr, so we can capture *everything* that comes out of
# the cube cli, and be as selective as possible in what to show to the user
use IPC::Open3 ('open3');
                         
# open3 will automatically create handles for the subprocess
# stdin and stdout, but not stderr, so we need gensym to create the stderr handle
# (don't ask me how this works, idfk)
use Symbol ('gensym'); 

# https://perldoc.perl.org/List::Util
use List::Util ('max', 'any', 'none');

# this is just how you import environment variables in perl
# if CUBEBA_PROJECT does not exist in the environment then the $CUBEBA_PROJECT
# variable will be falsey
use Env ('CUBEBA_PROJECT');

# url to print at the user as a nice ol' RTFM
my $CUBE_ARTICLE_URL  = 'https://community.st.com/stm32-software-tools-165/introducing-stm32cubecli-your-stm32-toolchain-from-the-command-line-168704';
my $CUBE_CLI_HELP_URL = 'https://dev.st.com/stm32cube-docs/stm32cubecli/latest/en/docs/markup/STM32CubeCLI_Command_Reference.html';
# for docs see also frt electronics readme readme
# (must be in the organization to see the readme)
# https://github.com/FRT-Electronics/

my $VERBOSE =  any { is_flag_present($_) } ('-v', '--verbose');
my $TARGET  = (any { is_flag_present($_) } ('-r', '--release'))
    ? 'Release'
    : 'Debug';

my $PROJECT_NAME=find_project_name();
my @REQUIRED_BUNDLES=('cmake', 'stlink-gdbserver', 'programmer');

my $ELF_FILE_PATH  = "$SCRIPT_DIR/build/$TARGET/$PROJECT_NAME.elf";

my $CUBE_PROGRAMMER_BIN_DIR_PATH; # will be set to
                                  # path_dir(find_command_path('programmer'));
                                  # but only after we make sure the 'programmer'
                                  # bundle is actually installed.
                                  # we set it at the end of the `setup` function

# utils
sub path_dir ($path) {
    # `dirname` but less janky
    my ($volume, $dir, $file) = splitpath(rel2abs($path));
    return $dir;
}
sub path_file ($path) {
    # `basename` but less janky
    my ($volume, $dir, $file) = splitpath(rel2abs($path));
    return $file;
}
sub is_flag_present($target) {
    return scalar(grep { $_ eq $target } @ARGV);
}
# naming this `log` conflicted with perl's builtin `log` (logarithm) function
# I should come up with a better name, but not now
sub loggeroni(@shit) {
    my $logged_line = "[$0] ".join(' ', @shit);
    if ($VERBOSE) { print "$logged_line\n"; }
    # todo: put log line into a log file
}
sub find_project_name() {
    loggeroni("finding project name");
    # try finding project name using the following procedure
    # - use the CUBEBA_PROJECT environment variable if it is set
    # - otherwise
    #   + look for any .ioc files in the project root directory.
    #     we expect the ./cubeba to be in that directory so we're gonna
    #     treat $SCRIPT_DIR as the project directory
    #   + ensure there is only one such file (ie: `or die`)
    #   + remove the .ioc at the end and use that

    if($CUBEBA_PROJECT) {
        loggeroni("deriving project name from environment variable CUBEBA_PROJECT");
        loggeroni("project name is $CUBEBA_PROJECT");
        return $CUBEBA_PROJECT;
    }

    # glob returns a list of all paths matching that glob
    my @ioc_file_paths = glob("$SCRIPT_DIR/*.ioc");
    if (scalar(@ioc_file_paths) == 0) {
        die "no .ioc file found in project directory $SCRIPT_DIR";
    }
    if (scalar(@ioc_file_paths) > 1) {
        die "more than one .ioc file found in project directory $SCRIPT_DIR";
    }

    my $project_ioc_filename = path_file($ioc_file_paths[0]);
    my $project_name = (split /\./, $project_ioc_filename)[0];
    loggeroni("deriving project name from environment .ioc file in project directory");
    loggeroni("project name is $project_name");
    return $project_name;
}

# in the `read_multiple` function we wrangle bitmasks with `vec` and shit
# https://perldoc.perl.org/functions/vec
# and we need a way to check that the bitmask is all zero
# idk if there's a builtin function to do this, but rolling this was quick enough
sub is_bitmask_zero($mask, $size) {
    return none { vec($mask, $_, 1) } 0..$size;
}
# read multiple handles without blocking
# based on the following recipe from the perl cookbok
# https://www.oreilly.com/library/view/perl-cookbook/1565922433/ch07s14.html
# full recipe mirrored at
# https://users.softlab.ntua.gr/~sivann/books/OReilly%20Bookshelf/perl/cookbook/ch07_14.htm
#
# we can determine that to to read from multple streams without blocking on
# any of em we're gonna need the 4 argument select function.
# https://perldoc.perl.org/functions/select#select-RBITS,WBITS,EBITS,TIMEOUT
# (select/1 and select/4 are two *very* different functions)
# 
# also quoting from the recipe:
# > Don't mix calls to four-argument select with calls to any of the buffered
# > I/O functions [...] (read, <>, seek, tell, etc.).
# > Instead, you must use sysread - and sysseek if you want to reposition the
# > filehandle within the file.
# 
# so we're gonna need the `sysread` function as well (4 argument variant)
# https://perldoc.perl.org/functions/sysread#sysread-FILEHANDLE,SCALAR,LENGTH,OFFSET
sub read_multiple(@handles) {
    # how much are we gonna read per sysread
    my $bufsize = 1024;
    # no timeout: block until something becomes available
    my $select_timeout = undef;

    my @filenos = map { fileno($_) } @handles;
    my $max_fileno = max(@filenos);

    my @collected = map { '' } @handles;
    my @offs = map { 0 } @handles;
    # $collected[i] will be the collected output from $handle[i]
    # $offs[i] will be the offset we're currently at in filehandle i
    #
    # we need to keep track of the offsets ourselves because we're using sysread
    # and @collected contains strings... also because we're using sysread
    # sysread returns file data by taking a string and appending the data into it

    # prepare "here's the files we care about" set we're gonna pass to select
    # (select accepts a bitmask because fuck you)
    my $filenos_mask = '';
    foreach (@filenos) { vec($filenos_mask, $_, 1) = 1; }

    while ((not is_bitmask_zero($filenos_mask, $max_fileno))
           and
           (my $nfound = select(my $out = $filenos_mask,
                                undef,
                                undef,
                                $select_timeout))) {
        foreach my $i (0..$#handles) {
            my $handle = $handles[$i];
            my $fileno = $filenos[$i];

            if (vec($out, $fileno, 1)) {
                my $n_bytes_read = sysread($handle,
                                           $collected[$i],
                                           $bufsize,
                                           $offs[$i]);

                # from https://perldoc.perl.org/functions/sysread
                # > Returns the number of bytes actually read,
                # > 0 at end of file, or undef if there was an error
                # > (in the latter case $! is also set)
                if (not defined($n_bytes_read)) {
                    die "sysread failed: $!";
                }
                if ($n_bytes_read == 0) {
                    vec($filenos_mask, $fileno, 1) = 0;
                }

                $offs[$i] += $n_bytes_read;
            }
        }
    }

    return @collected;
}

# render shell command as string (for error reporting)
sub stringify_cmd(@cmd) {
    return join ' ', map { $_ =~ /\s/ ? "'$_'" : $_ } @cmd;
}

sub run(@cmd) {
    my $cmd_s = stringify_cmd(@cmd);
    loggeroni("running command: [$cmd_s]");
    my $pid = open3(my $CH_STDIN_FH,
                    my $CH_STDOUT_FH,
                    my $CH_STDERR_FH = gensym,
                    @cmd);
    close($CH_STDIN_FH) or die "could not close stdin of command [$cmd_s]: $!";
    my ($ch_output, $ch_errput) = read_multiple($CH_STDOUT_FH, $CH_STDERR_FH);
    close($CH_STDOUT_FH) or die "could not close stdin of command [$cmd_s]: $!";
    close($CH_STDERR_FH) or die "could not close stdin of command [$cmd_s]: $!";
    waitpid($pid, 0) or die "failed to wait on command [$cmd_s]: $!";
    my $ch_exit_status = $? >> 8;
    return ($ch_exit_status, $ch_output, $ch_errput);
}

sub run_or_die(@cmd) {
    my $cmd_s = stringify_cmd(@cmd);
    loggeroni("run or die: [$cmd_s]");
    my ($retcode, $output, $errput) = run(@cmd);
    if ($retcode != 0) {
        die "failed to run command [$cmd_s]: $!\n";
    }
    return ($retcode, $output, $errput);
}

sub find_command_path($command) {
    # example output of a `cube --resolve` command
    # $ cube --resolve programmer
    # Command: '/home/nil/.local/share/stm32cube/bundles/programmer/2.23.0/bin/STM32_Programmer_CLI'
    # <and some more shit>
    # 
    # we only want the command path, so /home/nil/...
    loggeroni("looking for cube command: [$command]");
    my ($retcode, $output, $errput) = run_or_die('cube', '--resolve', $command);
    return $output =~ /^\s*Command: '([^']+)'/ ? $1 : undef;
}

sub is_bundle_installed($bundle) {
    loggeroni("looking for cube bundle: [$bundle]");
    my ($retcode, $output, $errput) = run('cube', '--resolve', $bundle);
    return ($retcode == 0);
}

sub install_bundle($bundle) {
    loggeroni("installing cube bundle: [$bundle]");
    run_or_die('cube', 'bundle', 'install', $bundle);
}

# roba di setup
sub setup() {
    loggeroni("setup");
    my ($retcode, $output, $errput) = run('cube', '--version');
    ($retcode == 0) or die
        join("\n", ("cube cli executable not found",
                    "please install the damn thing before running this script",
                    "see the following article from stm32 for more info",
                    $CUBE_ARTICLE_URL));
         
    loggeroni("installing project bundles (if not present)");
    run_or_die('cube', 'bundle', 'install', '--project');

    loggeroni("installing some extra required bundles");
    foreach my $req (@REQUIRED_BUNDLES) {
        if(not is_bundle_installed($req)) {
             install_bundle($req);
        }
    }

    $CUBE_PROGRAMMER_BIN_DIR_PATH=path_dir(find_command_path('programmer'));
}

sub build() {
    loggeroni("building");
    run_or_die('cube', 'cmake', '--preset', $TARGET);
    run_or_die('cube', 'cmake', '--build', '--preset', $TARGET);
}

# flasha roba
sub programmer() {
    loggeroni("flashing");
    run_or_die('cube', 'programmer',
               '-c',
               'port=SWD',
               'mode=NORMAL',
               '-w', $ELF_FILE_PATH,
               '-v',
               '-rst');
}

sub debugger_server() {
    loggeroni("debugger server");
    run_or_die('cube', 'stlink-gdbserver',
               '-d',
               '--frequency', '1000',
               '-p', '3333',
               '-s',
               '-cp', $CUBE_PROGRAMMER_BIN_DIR_PATH);
}

sub main() {
    setup();
    if(scalar(@ARGV) == 0) {
        loggeroni("no flags provided, we'll default to just building");
        build();
        return;
    }

    my $command = $ARGV[0];
    if ($command eq 'build') {
        build();
    }
    elsif ($command eq 'flash') {
        programmer();
    }
    elsif ($command eq 'debug') {
        debugger_server();
    }
    else {
        loggeroni("unrecognized command [$command], we'll default to just building");
        build();
    }
}

main();
